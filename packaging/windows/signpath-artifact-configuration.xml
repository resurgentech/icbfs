<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath's artifact configuration for a release: the two MSIs the
  release workflow uploads as one GitHub artifact (a zip), each signed
  deep: the programs inside, then the MSI. Pasted into the SignPath
  project by hand (icbfs-pro windows/docs/signpath.md has the steps);
  the workflow passes the release's version as the "version" parameter,
  and SignPath checks every file's product name and version against it.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <msi-file path="icbfs-${version}-x64.msi">
      <pe-file path="icbfs-winfsp.exe" product-name="icbfs" product-version="${version}">
        <authenticode-sign />
      </pe-file>
      <pe-file path="icbfs-cli.exe" product-name="icbfs" product-version="${version}">
        <authenticode-sign />
      </pe-file>
      <authenticode-sign />
    </msi-file>
    <msi-file path="icbfs-${version}-arm64.msi">
      <pe-file path="icbfs-winfsp.exe" product-name="icbfs" product-version="${version}">
        <authenticode-sign />
      </pe-file>
      <pe-file path="icbfs-cli.exe" product-name="icbfs" product-version="${version}">
        <authenticode-sign />
      </pe-file>
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
